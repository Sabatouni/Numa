# ── Supabase (required) ─────────────────────────────────────────────
# Project URL — Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Publishable ("anon") API key — Dashboard → Project Settings → API Keys.
# Safe to expose in the browser: Row Level Security controls all access.
VITE_SUPABASE_ANON_KEY=

# ── Site (required) ─────────────────────────────────────────────────
# Your deployed domain (no trailing slash). Used for canonical URLs,
# Open Graph tags, and the product link inside WhatsApp order messages.
VITE_SITE_URL=

# ── Contact & socials (optional fallbacks) ──────────────────────────
# These seed the site BEFORE any values exist in the database.
# Once you edit Settings or Social Links in the admin studio (/admin),
# the database values take over and these are ignored.
# WhatsApp: digits only, with country code, e.g. 255712345678
VITE_WHATSAPP_NUMBER=
VITE_INSTAGRAM=
VITE_FACEBOOK=
VITE_TIKTOK=
VITE_THREADS=
VITE_PINTEREST=
VITE_YOUTUBE=
